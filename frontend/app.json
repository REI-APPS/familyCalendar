{
  "expo": {
    "name": "Agenda da Família",
    "slug": "agenda-familia",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "agendafamilia",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "primaryColor": "#FF8FA3",
    "description": "Organiza a rotina da tua família num só lugar.",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.grouprei.familycalendar",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.grouprei.familycalendar",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FDFDF9"
      },
      "edgeToEdgeEnabled": true,
      "permissions": ["INTERNET", "RECEIVE_BOOT_COMPLETED"],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FDFDF9"
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "Agenda",
              "label": "Agenda da Família",
              "description": "Mostra a agenda da tua família no ecrã principal.",
              "minWidth": "250dp",
              "minHeight": "180dp",
              "targetCellWidth": 4,
              "targetCellHeight": 3,
              "previewImage": "./assets/images/icon.png",
              "updatePeriodMillis": 1800000,
              "resizeMode": "horizontal|vertical"
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
