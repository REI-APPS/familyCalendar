{
  "expo": {
    "name": "Agenda da Família",
    "slug": "agenda-familia",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "agendafamilia",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "primaryColor": "#FF8FA3",
    "description": "Organiza a rotina da tua família num só lugar. Cria horários por membro, vê o mês completo e sincroniza em tempo real entre todos os dispositivos.",
    "githubUrl": "",
    "privacy": "public",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.familia.agenda",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.familia.agenda",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FDFDF9"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "INTERNET",
        "RECEIVE_BOOT_COMPLETED"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FDFDF9"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2ab9499f-ab89-4d37-8f2c-349c6ac3a7d8"
      }
    },
    "owner": "nrei"
  }
}
