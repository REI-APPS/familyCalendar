{
  "expo": {
    "name": "Agenda da Família",
    "slug": "agenda-familia",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "agendafamilia",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "primaryColor": "#FF8FA3",
    "description": "Organiza a rotina da tua família num só lugar.",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.grouprei.familyCalendar",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.grouprei.familyCalendar",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FDFDF9"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "INTERNET",
        "RECEIVE_BOOT_COMPLETED"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FDFDF9"
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "Agenda",
              "label": "Agenda · Hoje",
              "description": "Mostra a agenda do dia (auto 4×1 ou 4×2).",
              "minWidth": "180dp",
              "minHeight": "40dp",
              "targetCellWidth": 4,
              "targetCellHeight": 1,
              "previewImage": "./assets/images/icon.png",
              "updatePeriodMillis": 1800000,
              "resizeMode": "horizontal|vertical"
            },
            {
              "name": "AgendaWeek",
              "label": "Agenda · Semana",
              "description": "Vista semanal: dia por linha, membro por coluna.",
              "minWidth": "280dp",
              "minHeight": "260dp",
              "targetCellWidth": 4,
              "targetCellHeight": 5,
              "previewImage": "./assets/images/icon.png",
              "updatePeriodMillis": 1800000,
              "resizeMode": "horizontal|vertical"
            },
            {
              "name": "AgendaPlus",
              "label": "Agenda · Hoje + Tarefas",
              "description": "Agenda de hoje numa linha e 4 tarefas na outra.",
              "minWidth": "280dp",
              "minHeight": "160dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "previewImage": "./assets/images/icon.png",
              "updatePeriodMillis": 1800000,
              "resizeMode": "horizontal|vertical"
            }
          ]
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
